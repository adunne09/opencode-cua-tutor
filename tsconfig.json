{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "types": ["bun", "node"],
    "lib": ["ES2023"]
  },
  "include": ["src", "bin", "test", "scripts"]
}
